# Math Checker V6 — environment configuration template.
#
# Copy this file to `.env` and adjust values as needed. Every variable is
# optional; the defaults below are what the application uses when nothing is
# set. Values here are PLACEHOLDERS ONLY — never put real credentials in this
# file, and never commit a filled-in `.env`.
#
# A value already present in the process environment always wins over `.env`.

# Interface to bind. The default keeps the app private to this machine.
# Use 0.0.0.0 only when you deliberately want LAN access.
MC6_HOST=127.0.0.1

# TCP port to listen on.
MC6_PORT=8643

# Debug mode: 1/true enables verbose application logging.
MC6_DEBUG=0

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
MC6_LOG_LEVEL=INFO

# Application data directory (persistent data, reports, cache, temp files).
# The SQLite database (app.db) is created inside this directory, so this is
# the single storage override for local runs and persistent cloud volumes.
# Relative paths resolve against the working directory. Default: ./data
MC6_DATA_DIR=

# Application temporary directory. Correction upload workspaces live under
# <MC6_DATA_DIR>/uploads/<job_id> and are removed when a job finishes.
# Default: <MC6_DATA_DIR>/tmp
MC6_TMP_DIR=

# ---------------------------------------------------------------------------
# Correction engine (Phase 3). Without a key the engine reports itself as
# unavailable and no correction can run; nothing is simulated.
# ---------------------------------------------------------------------------
# Gemini API key, consumed server-side only. The browser never sees this value.
# Provider configuration is read at startup; restart after changing it.
# MC6_AI_API_KEY=replace-me

# Model used for correction (default: gemini-3.5-flash-lite).
# MC6_AI_MODEL=gemini-3.5-flash-lite

# Provider endpoint (default: https://generativelanguage.googleapis.com).
# MC6_AI_BASE_URL=

# Per-request timeout in seconds (5–600, default 180).
# MC6_AI_TIMEOUT_SECONDS=180

# Transient-failure retries (0–5, default 2).
# MC6_AI_MAX_RETRIES=2

# Path to a Google Classroom OAuth client JSON file. This is NOT a secret:
# it is the "Desktop app" client-secret JSON downloaded from Google Cloud
# (also accepted inline as {"installed":{...}}; it is materialised into
# <MC6_DATA_DIR>/secrets/). Without it Classroom stays disconnected.
# MC6_GOOGLE_OAUTH_CLIENT=replace-me
